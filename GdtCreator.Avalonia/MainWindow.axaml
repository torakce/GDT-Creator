<Window
    x:Class="GdtCreator.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GdtCreator.Avalonia.Controls"
    Title="GDT Creator"
    Width="1420"
    Height="880"
    MinWidth="1120"
    MinHeight="740">
  <Window.Styles>
    <Style Selector="ListBox.clean">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="ListBox.clean ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.choice-card">
      <Setter Property="Background" Value="#F7FAFD" />
      <Setter Property="BorderBrush" Value="#D5E2EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Border.choice-chip">
      <Setter Property="Background" Value="#F8FBFD" />
      <Setter Property="BorderBrush" Value="#D5E2EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.choice-card:pointerover">
      <Setter Property="BorderBrush" Value="#93B7CA" />
      <Setter Property="Background" Value="#F3F8FC" />
    </Style>

    <Style Selector="Border.choice-chip:pointerover">
      <Setter Property="BorderBrush" Value="#93B7CA" />
      <Setter Property="Background" Value="#F3F8FC" />
    </Style>

    <Style Selector="ListBox.clean ListBoxItem:selected Border.choice-card">
      <Setter Property="Background" Value="#DCECF6" />
      <Setter Property="BorderBrush" Value="#175676" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="ListBox.clean ListBoxItem:selected Border.choice-chip">
      <Setter Property="Background" Value="#DCECF6" />
      <Setter Property="BorderBrush" Value="#175676" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="CharacteristicTemplate">
      <Border Classes="choice-card" Width="148" Height="78">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="42" Height="42" Background="#EFF5F9" CornerRadius="11">
            <controls:SymbolSwatchControl Width="36" Height="36" StrokeThickness="2.1" Symbol="{Binding Symbol}" IsVisible="{Binding HasSymbol}" />
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#102A43" Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Category}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ChipTemplate">
      <Border Classes="choice-chip">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" Background="#EFF5F9" CornerRadius="8" IsVisible="{Binding HasSymbol}">
            <controls:SymbolSwatchControl Width="20" Height="20" StrokeThickness="1.7" Symbol="{Binding Symbol}" />
          </Border>
          <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" Text="{Binding DisplayLabel}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ColorPresetTemplate">
      <Border Classes="choice-chip" MinWidth="104">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="9" Background="{Binding SwatchHex}" BorderBrush="#D5E2EC" BorderThickness="1" />
          <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" Text="{Binding Label}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="DatumConditionTemplate">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="24" Height="24" Background="#EFF5F9" CornerRadius="8" IsVisible="{Binding HasSymbol}">
          <controls:SymbolSwatchControl Width="20" Height="20" StrokeThickness="1.7" Symbol="{Binding Symbol}" />
        </Border>
        <TextBlock VerticalAlignment="Center" Text="{Binding DisplayLabel}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16" RowDefinitions="Auto,*" ColumnDefinitions="1.8*,1*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="16,14" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#102A43" Text="GDT Creator" />
          <TextBlock Foreground="#5B6674" Text="Tolerance editor rebuilt in Avalonia with denser controls and direct symbol selection." />
        </StackPanel>

        <Border Grid.Column="1" Background="#D9ECF5" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
          <TextBlock Foreground="#175676" FontWeight="SemiBold" Text="ISO GPS" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,14,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="16">
          <StackPanel>
            <TextBlock Classes="section-title" Text="Characteristic" />
            <TextBlock Classes="field-label" Text="Choose the tolerance type directly from its symbol." />
            <ListBox Classes="clean"
                     ItemsSource="{Binding Characteristics}"
                     SelectedItem="{Binding SelectedCharacteristic}"
                     ItemTemplate="{StaticResource CharacteristicTemplate}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="1.3*,1*" ColumnSpacing="14">
          <Border Grid.Column="0" Classes="card" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Classes="section-title" Text="Tolerance" />

              <StackPanel Spacing="6">
                <TextBlock Classes="field-label" Text="Value" />
                <TextBox Text="{Binding ToleranceValue}" Watermark="0.2 CZ UZ -0.2" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="Type CZ and UZ directly in the value field when needed." TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="field-label" Text="Output color" />
                <ListBox Classes="clean"
                         ItemsSource="{Binding QuickColorOptions}"
                         SelectedItem="{Binding SelectedContentColor}"
                         ItemTemplate="{StaticResource ColorPresetTemplate}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="field-label" Text="Zone modifier" />
                <ListBox Classes="clean"
                         ItemsSource="{Binding ZoneModifiers}"
                         SelectedItem="{Binding SelectedZoneModifier}"
                         ItemTemplate="{StaticResource ChipTemplate}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="field-label" Text="Material condition" />
                <ListBox Classes="clean"
                         ItemsSource="{Binding ToleranceMaterialConditions}"
                         SelectedItem="{Binding SelectedToleranceMaterialCondition}"
                         ItemTemplate="{StaticResource ChipTemplate}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Spacing="14">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Classes="section-title" Text="Datum Reference System" />
                <TextBlock Classes="muted" Text="{Binding DatumSectionHint}" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding DatumSlots}" IsEnabled="{Binding AreDatumInputsEnabled}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="84,76,*" ColumnSpacing="8" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#5B6674" Text="{Binding Ordinal}" />
                        <TextBox Grid.Column="1" Text="{Binding Label}" MaxLength="4" HorizontalContentAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding DataContext.DatumConditionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValueBinding="{Binding Value}"
                                  SelectedValue="{Binding MaterialCondition}"
                                  ItemTemplate="{StaticResource DatumConditionTemplate}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Classes="section-title" Text="Annotations" />
                <TextBlock Classes="muted" Text="Optional notes and frame flags that change the rendered output." TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <CheckBox Content="Text above the frame" IsChecked="{Binding TopTextEnabled}" />
                    <TextBox Text="{Binding TopText}" Watermark="Text above" IsVisible="{Binding TopTextEnabled}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <CheckBox Content="Text below the frame" IsChecked="{Binding BottomTextEnabled}" />
                    <TextBox Text="{Binding BottomText}" Watermark="Text below" IsVisible="{Binding BottomTextEnabled}" />
                  </StackPanel>
                </Grid>

                <WrapPanel Orientation="Horizontal" ItemWidth="220" ItemHeight="34">
                  <CheckBox Content="Projected tolerance zone" IsChecked="{Binding ProjectedToleranceZone}" />
                  <CheckBox Content="Free state" IsChecked="{Binding FreeState}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16">
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="section-title" Text="Preview" />
          <TextBlock Classes="muted" Text="Live frame rendering updates as you edit the current specification." TextWrapping="Wrap" />
          <controls:TolerancePreviewControl Height="300" RenderModel="{Binding RenderModel}" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16" Background="#EEF7FC" BorderBrush="#B7D2E1" IsVisible="{Binding IsSpecValid}">
        <StackPanel Spacing="6">
          <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#175676" Text="Status" />
          <TextBlock Foreground="#175676" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16" Background="#FFF4F2" BorderBrush="#F0C5BF" IsVisible="{Binding HasValidationErrors}">
        <StackPanel Spacing="6">
          <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#B42318" Text="Validation" />
          <TextBlock Foreground="#B42318" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ValidationErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="- {Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="Actions" />
          <TextBlock Classes="muted" Text="Copy and export become available when the current frame validates cleanly. Exports are fixed at 4x." TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <Button Grid.Row="0" Grid.Column="0" Classes="secondary" Command="{Binding CopyImageCommand}" Content="Copy Image" />
            <Button Grid.Row="0" Grid.Column="1" Classes="secondary" Command="{Binding CopyVectorCommand}" Content="Copy Vector" />
            <Button Grid.Row="1" Grid.Column="0" Classes="action" Command="{Binding ExportPngCommand}" Content="Export PNG" />
            <Button Grid.Row="1" Grid.Column="1" Classes="action" Command="{Binding ExportSvgCommand}" Content="Export SVG" />
            <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="action" Command="{Binding ExportEmfCommand}" Content="Export EMF" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
